---
import '../styles/global.css';
import '../styles/content.css';
import { EDITOR_ENABLED } from '../lib/editor-enabled';

export interface Props {
  title: string;
  description?: string;
  /**
   * Content id (`site/home`, `projects/pokeapi`…). When set, and only where the
   * editor is enabled (`ENABLE_EDITOR`, on by default under `astro dev`), the
   * header shows the Edit link that opens this page's `.md` in the editor.
   */
  editSlug?: string;
}

const {
  title,
  description = 'Portfolio of Jesús Caballero Rodríguez — Backend Engineer',
  editSlug,
} = Astro.props;
const showEdit = EDITOR_ENABLED && Boolean(editSlug);
const currentYear = new Date().getFullYear();
const site = Astro.site ?? new URL('https://jecaro094.github.io/');
const pageUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/media/foto-perfil.webp', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jesús Caballero Rodríguez — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Home">
        <img src="/favicon.png" alt="" width="32" height="32" class="brand-icon" />
      </a>
      <nav class="section-nav" aria-label="Sections">
        <a href="/#experience" class="nav-tab" data-section="experience">Experience</a>
        <a href="/#projects" class="nav-tab" data-section="projects">Projects</a>
        {showEdit && <a href={`/editor/${editSlug}/edit`} class="nav-tab edit-tab">Edit</a>}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>© {currentYear} Jesús Caballero Rodríguez</p>
    </footer>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" id="lightboxClose" aria-label="Close">✕</button>
      <img src="" alt="" id="lightboxImg" />
    </div>
  </body>
</html>

<script>
  import { wireInteractions } from '../scripts/interactions';

  wireInteractions();

  function scrollToHash() {
    const hash = window.location.hash;
    if (!hash) return;
    const target = document.querySelector(hash);
    if (target) {
      requestAnimationFrame(() => {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  }

  window.addEventListener('load', scrollToHash);
  window.addEventListener('hashchange', scrollToHash);
</script>
