---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const entry = await getEntry('projects', 'qr-voting-survey');
const { title, tagline, cover, contextHeading, demo, technologies } = entry.data;
const { Content } = await render(entry);

const explanationEntry = await getEntry('explanations', 'qr-voting-survey');
const { Content: ExplanationContent } = await render(explanationEntry);
---

<Layout title={`${title} — Jesús Caballero Rodríguez`}>
  <main class="project-page">
    <header class="project-hero animate" style="animation-delay: 0.1s">
      <a href="/" class="back-pill">← Back</a>
      <Image src={cover} alt="" class="hero-bg" loading="lazy" />
      <span class="hero-overlay" aria-hidden="true"></span>
      <h1 class="gradient-text">{title}</h1>
      <p class="tagline">{tagline}</p>
    </header>

    <section class="section animate" id="context" style="animation-delay: 0.2s">
      <h2>{contextHeading}</h2>
      <Content />
    </section>

    <section class="section animate" id="demo" style="animation-delay: 0.3s">
      <h2>Demo</h2>
      <div class="video-embed">
        <iframe
          src={`https://www.youtube.com/embed/${demo.youtubeId}`}
          title={demo.title}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </section>

    <section class="section animate" id="explanation" style="animation-delay: 0.4s">
      <h2>Explanation</h2>
      <ExplanationContent />
    </section>

    <section class="section animate" id="technologies" style="animation-delay: 0.5s">
      <h2>Technologies</h2>
      <div class="tech-grid">
        {
          technologies.map((tech) => (
            <div class="tech-card">
              <h4>{tech.heading}</h4>
              <ul>
                {tech.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" id="lightboxClose" aria-label="Close">✕</button>
      <img src="" alt="" id="lightboxImg" />
    </div>
  </main>
</Layout>

<style is:global>
  /* Rendered from Markdown/HTML in src/content/explanations/qr-voting-survey.md,
     so these rules must be global (scoped styles don't reach <Content /> output). */
  .details-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: linear-gradient(145deg, #171b23, #12151b);
    margin: 1.5rem 0;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .details-card[open] {
    border-color: rgba(79, 140, 255, 0.5);
    box-shadow: 0 8px 24px rgba(79, 140, 255, 0.12);
  }

  .details-card summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
    padding: 1rem 1.25rem;
    font-size: 1.05rem;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.2s ease;
  }

  .details-card summary::-webkit-details-marker {
    display: none;
  }

  .details-card summary:hover {
    color: var(--accent);
  }

  .details-card .chevron {
    transition: transform 0.25s ease;
    color: var(--muted);
  }

  .details-card[open] .chevron {
    transform: rotate(180deg);
  }

  .details-body {
    padding: 0 1.25rem 1.25rem;
  }

  .steps {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    counter-reset: step;
  }

  .step-item {
    position: relative;
  }

  .step-badge {
    position: absolute;
    top: 1.05rem;
    left: 1rem;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.75rem;
    color: #fff;
    background: linear-gradient(135deg, var(--accent), rgba(79, 140, 255, 0.5));
    box-shadow: 0 4px 12px rgba(79, 140, 255, 0.3);
    z-index: 2;
  }

  .step-content {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9rem 1.1rem 0.9rem 2.9rem;
    background: #14171d;
  }

  .step-content h5 {
    font-size: 1rem;
    margin-bottom: 0.4rem;
    color: var(--accent);
  }

  .step-content p {
    margin: 0;
  }

  .endpoint-list {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .endpoint {
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    background: linear-gradient(145deg, #1a1f28, #15191f);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .endpoint:hover {
    border-color: rgba(79, 140, 255, 0.5);
    box-shadow: 0 6px 18px rgba(79, 140, 255, 0.12);
  }

  .endpoint-path {
    display: inline-block;
    font-size: 0.9em;
    margin-bottom: 0.4rem;
  }

  .endpoint-desc {
    margin: 0;
    color: var(--fg);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .schema-figure {
    margin: 1.25rem 0;
  }
  .schema-figure img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }
  .schema-wrap {
    position: relative;
    display: block;
    border-radius: 12px;
    overflow: hidden;
    cursor: zoom-in;
  }
  .schema-wrap img {
    display: block;
    transition: transform 0.3s ease, filter 0.3s ease;
  }
  .schema-wrap:hover img {
    filter: brightness(1.05);
    transform: scale(1.02);
  }
  .zoom-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.7rem 1rem;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #fff;
    background: linear-gradient(0deg, rgba(8, 10, 13, 0.9), rgba(8, 10, 13, 0));
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .schema-wrap:hover .zoom-hint {
    opacity: 1;
    transform: translateY(0);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: rgba(8, 10, 13, 0.98);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .lightbox.open {
    opacity: 1;
    visibility: visible;
  }
  .lightbox img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    cursor: zoom-out;
  }
  .lightbox-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: rgba(20, 23, 29, 0.8);
    color: var(--fg);
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .lightbox-close:hover {
    background: rgba(79, 140, 255, 0.25);
    transform: rotate(90deg);
  }
  .schema-figure figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .flow {
    margin: 0.5rem 0 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .flow .step {
    font-weight: 600;
    color: var(--accent);
  }

  .auth-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .auth-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    background: linear-gradient(145deg, #171b23, #12151b);
    transition: border-color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
  }

  .auth-card:hover {
    border-color: rgba(79, 140, 255, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(79, 140, 255, 0.12);
  }

  .auth-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), rgba(79, 140, 255, 0.1));
  }

  .auth-card h5 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .auth-card .purpose {
    color: var(--muted);
    font-size: 0.875rem;
    margin-top: 0.5rem;
    margin-bottom: 0;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--border);
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg');
  const lightboxClose = document.getElementById('lightboxClose');

  document.querySelectorAll('.schema-wrap.zoomable').forEach((wrap) => {
    wrap.addEventListener('click', () => {
      const img = wrap.querySelector('img');
      lightboxImg.src = img.currentSrc || img.src;
      lightboxImg.alt = img.alt;
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden', 'false');
    });
  });

  const closeLightbox = () => {
    lightbox.classList.remove('open');
    lightbox.setAttribute('aria-hidden', 'true');
    lightboxImg.src = '';
  };

  lightboxClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
