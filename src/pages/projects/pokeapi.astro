---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import githubIcon from '../../assets/github.png';

const entry = await getEntry('projects', 'pokeapi');
const { title, tagline, cover, demo, technologies, repoUrl } = entry.data;
const { Content } = await render(entry);
---

<Layout title={`${title} — Jesús Caballero Rodríguez`}>
  <main class="project-page">
    <header class="project-hero animate" style="animation-delay: 0.1s">
      <a href="/" class="back-pill">← Back</a>
      <Image src={cover} alt="" class="hero-bg" loading="lazy" />
      <span class="hero-overlay" aria-hidden="true"></span>
      <h1 class="gradient-text">{title}</h1>
      <p class="tagline">{tagline}</p>
    </header>

    <section class="section animate" id="context" style="animation-delay: 0.2s">
      <h2>Context</h2>
      <Content />
    </section>

    <section class="section animate" id="demo" style="animation-delay: 0.3s">
      <h2>Demo</h2>
      <div class="video-embed">
        <iframe
          src={`https://www.youtube.com/embed/${demo.youtubeId}`}
          title={demo.title}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </section>

    <section class="section animate" id="technologies" style="animation-delay: 0.4s">
      <h2>Technologies</h2>
      <div class="tech-grid">
        {
          technologies.map((tech) => (
            <div class="tech-card">
              <h4>{tech.heading}</h4>
              <ul>
                {tech.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    {repoUrl && (
      <section class="section animate" id="source" style="animation-delay: 0.5s">
        <h2>Source Code</h2>
        <div class="repo-links">
          <a href={typeof repoUrl === 'string' ? repoUrl : repoUrl[0]} target="_blank" rel="noopener noreferrer" class="repo-btn">
            <Image src={githubIcon} alt="" class="repo-btn-icon" />
            <span>View on GitHub</span>
          </a>
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .repo-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .repo-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--fg);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease, background 0.25s ease;
  }

  .repo-btn:hover {
    border-color: rgba(79, 140, 255, 0.55);
    background: rgba(79, 140, 255, 0.08);
    box-shadow: 0 8px 24px rgba(79, 140, 255, 0.15);
    transform: translateY(-2px);
  }

  .repo-btn-icon {
    width: 20px;
    height: 20px;
    filter: invert(1) brightness(1.2);
    transition: filter 0.2s ease;
  }

  .repo-btn:hover .repo-btn-icon {
    filter: invert(1) brightness(1.5);
  }
</style>


