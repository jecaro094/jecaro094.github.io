---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const entry = await getEntry('projects', 'pokeapi');
const { title, tagline, cover, demo, technologies } = entry.data;
const { Content } = await render(entry);
---

<Layout title={`${title} — Jesús Caballero Rodríguez`}>
  <main class="project-page">
    <header class="project-hero animate" style="animation-delay: 0.1s">
      <a href="/" class="back-pill">← Back</a>
      <Image src={cover} alt="" class="hero-bg" loading="lazy" />
      <span class="hero-overlay" aria-hidden="true"></span>
      <h1 class="gradient-text">{title}</h1>
      <p class="tagline">{tagline}</p>
    </header>

    <section class="section animate" id="context" style="animation-delay: 0.2s">
      <h2>Context</h2>
      <Content />
    </section>

    <section class="section animate" id="demo" style="animation-delay: 0.3s">
      <h2>Demo</h2>
      <div class="video-embed">
        <iframe
          src={`https://www.youtube.com/embed/${demo.youtubeId}`}
          title={demo.title}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </section>

    <section class="section animate" id="technologies" style="animation-delay: 0.4s">
      <h2>Technologies</h2>
      <div class="tech-grid">
        {
          technologies.map((tech) => (
            <div class="tech-card">
              <h4>{tech.heading}</h4>
              <ul>
                {tech.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Layout>


