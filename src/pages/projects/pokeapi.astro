---
import Layout from '../../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

// The slug is hardcoded here and must match the content filename
// (src/content/projects/pokeapi.md) — see CLAUDE.md.
const entry = await getEntry('projects', 'pokeapi');
const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title} — Jesús Caballero Rodríguez`}
  description={entry.data.tagline}
  editSlug="projects/pokeapi"
>
  <main class="page page-doc">
    <Content />
  </main>
</Layout>
