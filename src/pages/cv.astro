---
import Layout from '../layouts/Layout.astro';
import { SOCIAL_LINKS } from '../lib/constants';
---

<Layout title="CV — Jesús Caballero Rodríguez">
  <main class="project-page">
    <header class="project-hero cv-hero animate" style="animation-delay: 0.1s">
      <a href="/" class="back-pill">← Back</a>
      <span class="hero-overlay" aria-hidden="true"></span>
      <h1 class="gradient-text">CV</h1>
      <p class="tagline">Curriculum Vitae</p>
    </header>

    <section class="section animate" id="cv-viewer" style="animation-delay: 0.2s">
      <div class="cv-actions">
        <a href={SOCIAL_LINKS.cv_path} download class="download-btn">
          <span class="download-icon" aria-hidden="true">↓</span>
          Download CV (PDF)
        </a>
      </div>

      <div class="cv-container">
        <span class="cv-wrap zoomable">
          <img src="/cv/cv.png" alt="Curriculum Vitae — Jesús Caballero Rodríguez" class="cv-img" />
          <span class="zoom-hint">🔍 Click to view full screen</span>
        </span>
      </div>
    </section>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" id="lightboxClose" aria-label="Close">✕</button>
      <img src="" alt="" id="lightboxImg" />
    </div>
  </main>
</Layout>

<style>
  .cv-hero {
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(79, 140, 255, 0.15), transparent),
      radial-gradient(ellipse 60% 50% at 80% 100%, rgba(140, 90, 255, 0.1), transparent),
      linear-gradient(180deg, #14171d, #0f1115);
  }

  .cv-actions {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: all 0.25s ease;
  }

  .download-btn:hover {
    border-color: rgba(79, 140, 255, 0.55);
    background: linear-gradient(180deg, rgba(79, 140, 255, 0.1), rgba(79, 140, 255, 0.03));
    box-shadow: 0 8px 24px rgba(79, 140, 255, 0.18);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .download-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .cv-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .cv-wrap {
    position: relative;
    display: block;
    border-radius: 12px;
    overflow: hidden;
    cursor: zoom-in;
    border: 1px solid var(--border);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }

  .cv-wrap img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .cv-wrap:hover img {
    filter: brightness(1.05);
    transform: scale(1.02);
  }

  .zoom-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.7rem 1rem;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #fff;
    background: linear-gradient(0deg, rgba(8, 10, 13, 0.9), rgba(8, 10, 13, 0));
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  .cv-wrap:hover .zoom-hint {
    opacity: 1;
    transform: translateY(0);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: rgba(8, 10, 13, 0.98);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .lightbox.open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    cursor: zoom-out;
  }

  .lightbox-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: rgba(20, 23, 29, 0.8);
    color: var(--fg);
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .lightbox-close:hover {
    background: rgba(79, 140, 255, 0.25);
    transform: rotate(90deg);
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg');
  const lightboxClose = document.getElementById('lightboxClose');

  document.querySelectorAll('.cv-wrap.zoomable').forEach((wrap) => {
    wrap.addEventListener('click', () => {
      const img = wrap.querySelector('img');
      lightboxImg.src = img.currentSrc || img.src;
      lightboxImg.alt = img.alt;
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden', 'false');
    });
  });

  const closeLightbox = () => {
    lightbox.classList.remove('open');
    lightbox.setAttribute('aria-hidden', 'true');
    lightboxImg.src = '';
  };

  lightboxClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
