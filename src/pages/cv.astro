---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const cv = await getEntry('site', 'cv');
const { Content } = await render(cv);
---

<Layout title={cv.data.title} description={cv.data.tagline} editSlug="site/cv">
  <main class="page page-doc">
    <Content />
  </main>
</Layout>
