---
/*
 * Dev-only Markdown editor.
 *
 * Reads the raw `.md` from `src/content/`, server-renders the first preview so
 * the pane is populated before JS boots, then hands off to a CodeMirror 6 client
 * script. On a static build `import.meta.env.DEV` is false and this route 404s —
 * the published site is read-only.
 */
export const prerender = false;

import fs from 'node:fs/promises';
import { resolveContentPath, ContentPathError } from '../../../lib/content-files';
import { renderMarkdown, splitFrontmatter } from '../../../lib/markdown';
import '../../../styles/global.css';
import '../../../styles/content.css';
import '../../../styles/editor.css';

if (!import.meta.env.DEV) {
  return new Response('The editor is only available under `astro dev`.', {
    status: 404,
  });
}

const { slug } = Astro.params;

/** Public URL of the page a content file backs, for the Back / View links. */
function pageUrl(id: string | undefined): string {
  if (id === 'site/home') return '/';
  if (id === 'site/cv') return '/cv';
  if (id?.startsWith('projects/')) return `/${id}/`;
  return '/';
}

/** The landing page carries extra section chrome; the preview must match it. */
const pageClass = slug === 'site/home' ? 'page page-home' : 'page page-doc';
const viewUrl = pageUrl(slug);

let raw = '';
let initialHtml = '';
let loadError: string | null = null;

try {
  const target = resolveContentPath(slug);
  raw = await fs.readFile(target, 'utf8');
  const { body } = splitFrontmatter(raw);
  initialHtml = await renderMarkdown(body);
} catch (err) {
  if (err instanceof ContentPathError) {
    loadError = err.message;
  } else if ((err as NodeJS.ErrnoException).code === 'ENOENT') {
    loadError = `No content file named "${slug}.md" under src/content/.`;
  } else {
    loadError = `Could not open the file: ${(err as Error).message}`;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Editing {slug} — Portfolio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="editor-page">
    {
      loadError ? (
        <div class="editor-error">
          <p>{loadError}</p>
          <p><a href="/">← Back to the portfolio</a></p>
        </div>
      ) : (
        <>
          <header class="editor-bar">
            <a href={viewUrl}>← Back</a>
            <span class="editor-title">{slug}.md</span>
            <span class="editor-status" id="status" data-dirty="false">Saved</span>
            <div class="editor-actions">
              <a href={viewUrl} target="_blank" rel="noreferrer">View ↗</a>
              <button
                type="button"
                id="toggle-preview"
                class="editor-toggle"
                aria-pressed="true"
                title="Toggle the preview pane"
              >
                Preview
              </button>
              <button type="button" id="save">Save</button>
            </div>
          </header>

          <div class="editor-main" data-slug={slug} data-preview="on">
            <div class="editor-pane" id="editor" />
            <div class="editor-pane" id="preview">
              <main class={pageClass} id="preview-page" set:html={initialHtml} />
            </div>
          </div>

          <textarea id="doc-src" hidden>{raw}</textarea>
          <div class="toast-stack" id="toasts" aria-live="polite" />

          <div class="lightbox" id="lightbox" aria-hidden="true">
            <button class="lightbox-close" id="lightboxClose" aria-label="Close">✕</button>
            <img src="" alt="" id="lightboxImg" />
          </div>

          {/* Apply the persisted view mode before paint to avoid a split-view flash. */}
          <script is:inline>
            try {
              if (localStorage.getItem('editor:preview') === 'off') {
                document
                  .querySelector('.editor-main')
                  ?.setAttribute('data-preview', 'off');
                document
                  .querySelector('#toggle-preview')
                  ?.setAttribute('aria-pressed', 'false');
              }
            } catch (e) {}
          </script>
        </>
      )
    }

    <script>
      import { EditorView, basicSetup } from 'codemirror';
      import { keymap } from '@codemirror/view';
      import { EditorState } from '@codemirror/state';
      import { indentWithTab } from '@codemirror/commands';
      import { markdown, markdownLanguage } from '@codemirror/lang-markdown';
      import { languages } from '@codemirror/language-data';
      import { oneDark } from '@codemirror/theme-one-dark';
      import { autocompletion, snippetCompletion } from '@codemirror/autocomplete';
      import type { CompletionContext } from '@codemirror/autocomplete';
      import { wireInteractions } from '../../../scripts/interactions';

      const main = document.querySelector<HTMLElement>('.editor-main');
      const srcEl = document.querySelector<HTMLTextAreaElement>('#doc-src');
      const previewEl = document.querySelector<HTMLElement>('#preview-page');
      const statusEl = document.querySelector<HTMLElement>('#status');
      const saveBtn = document.querySelector<HTMLButtonElement>('#save');
      const toggleBtn = document.querySelector<HTMLButtonElement>('#toggle-preview');
      const toastStack = document.querySelector<HTMLElement>('#toasts');

      if (main && srcEl && previewEl && statusEl && saveBtn && toggleBtn && toastStack) {
        const slug = main.dataset.slug ?? '';

        // View mode: `split` (editor + preview) or `editor` (preview hidden).
        // Seeded from the inline pre-paint script's `data-preview`, persisted to
        // localStorage. While the preview is hidden we skip `/api/preview`
        // entirely and re-render once when it comes back.
        let previewVisible = main.dataset.preview !== 'off';

        function toast(message: string, kind: 'ok' | 'danger' = 'ok') {
          const el = document.createElement('div');
          el.className = `toast toast-${kind}`;
          el.textContent = message;
          toastStack!.append(el);
          window.setTimeout(() => el.remove(), kind === 'danger' ? 6000 : 3000);
        }

        // The preview renders the same HTML as a published page, so it gets the
        // same behaviour — tilt, copy buttons, lightbox — after every refresh.
        wireInteractions(previewEl);

        // --- dirty tracking ------------------------------------------------
        let savedText = srcEl.value;
        const isDirty = () => view.state.doc.toString() !== savedText;
        function refreshStatus() {
          const dirty = isDirty();
          statusEl!.dataset.dirty = String(dirty);
          statusEl!.textContent = dirty ? 'Unsaved' : 'Saved';
        }

        // --- live preview, debounced ~200ms --------------------------------
        let previewTimer: number | undefined;
        let previewSeq = 0;
        function schedulePreview() {
          if (!previewVisible) return; // pane is hidden — nothing to update
          window.clearTimeout(previewTimer);
          previewTimer = window.setTimeout(runPreview, 200);
        }
        async function runPreview() {
          const seq = ++previewSeq;
          try {
            const res = await fetch('/api/preview', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ content: view.state.doc.toString() }),
            });
            const data = await res.json();
            if (seq !== previewSeq) return; // a newer keystroke already won
            if (!res.ok) {
              toast(data.error ?? 'Preview failed', 'danger');
              return;
            }
            previewEl!.innerHTML = data.html;
            wireInteractions(previewEl!);
          } catch {
            if (seq === previewSeq) toast('Preview request failed', 'danger');
          }
        }

        // --- save ----------------------------------------------------------
        async function save() {
          if (!isDirty()) return;
          saveBtn!.disabled = true;
          try {
            const res = await fetch('/api/save', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ slug, content: view.state.doc.toString() }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.ok) {
              toast(data.error ?? `Save failed (${res.status})`, 'danger');
              return;
            }
            savedText = view.state.doc.toString();
            refreshStatus();
            toast('Saved to disk');
            // The Content Layer watches src/content/ and HMRs the published page
            // on its own; the preview pane here is already current.
          } catch {
            toast('Save request failed', 'danger');
          } finally {
            saveBtn!.disabled = false;
          }
        }

        // --- `:` directive snippets ----------------------------------------
        // One entry per block the Markdown pipeline understands, so the whole
        // vocabulary is discoverable without leaving the editor.
        const BLOCKS: [string, string, string][] = [
          [':::note', ':::note\n${}\n:::\n', 'admonition'],
          [':::info', ':::info\n${}\n:::\n', 'admonition'],
          [':::tip', ':::tip\n${}\n:::\n', 'admonition'],
          [':::warning', ':::warning\n${}\n:::\n', 'admonition'],
          [':::danger', ':::danger\n${}\n:::\n', 'admonition'],
          [
            ':::hero',
            ':::hero{cover="/media/covers/${slug}.webp"}\n# ${Title}\n\n${Tagline}\n:::\n',
            'page header',
          ],
          [
            ':::role',
            ':::role{period="${2024–2026}" logo="/media/logos/${company}.webp" color="${#4f8cff}"}\n### ${Role}\n\n${Company}\n\n${Summary}\n\n`${Tech}`\n:::\n',
            'experience entry',
          ],
          [
            ':::project',
            ':::project{href="/projects/${slug}/" cover="/media/covers/${slug}.webp"}\n### ${Name}\n\n${Description}\n\n`${Tech}`\n:::\n',
            'featured card',
          ],
          [':::grid', ':::grid\n### ${Heading}\n\n- ${Item}\n:::\n', 'card grid'],
          [':::details', ':::details[${Title}]\n${}\n:::\n', 'collapsible'],
          [':::steps', ':::steps\n1. **${Title}**\n\n   ${Body}\n:::\n', 'numbered steps'],
          [':::flow', ':::flow\n1. **${Step}** — ${Description}\n:::\n', 'flow list'],
          [
            ':::endpoints',
            ':::endpoints\n- `${GET /path}` — ${Description}\n:::\n',
            'endpoint cards',
          ],
          [':::repos', ':::repos\n- <${https://github.com/user/repo}>\n:::\n', 'repo buttons'],
          ['::youtube', '::youtube{id="${videoId}" title="${Demo}"}\n', 'video embed'],
          [
            '::download',
            '::download[${Download CV (PDF)}]{href="${/cv/file.pdf}"}\n',
            'download button',
          ],
          [
            ':link',
            ':link[${Label}]{href="${https://…}" icon="/media/icons/${name}.webp" copy}',
            'action pill',
          ],
        ];

        function directiveSource(context: CompletionContext) {
          const token = context.matchBefore(/:{1,3}[\w-]*/);
          if (!token || (token.from === token.to && !context.explicit)) return null;
          return {
            from: token.from,
            options: BLOCKS.map(([label, template, detail]) =>
              snippetCompletion(template, { label, type: 'keyword', detail }),
            ),
          };
        }

        const view = new EditorView({
          parent: document.querySelector('#editor')!,
          state: EditorState.create({
            doc: srcEl.value,
            extensions: [
              basicSetup,
              keymap.of([
                indentWithTab,
                {
                  key: 'Mod-s',
                  preventDefault: true,
                  run: () => {
                    void save();
                    return true;
                  },
                },
              ]),
              markdown({ base: markdownLanguage, codeLanguages: languages }),
              oneDark,
              EditorView.lineWrapping,
              autocompletion({ override: [directiveSource] }),
              EditorView.updateListener.of((u) => {
                if (u.docChanged) {
                  schedulePreview();
                  refreshStatus();
                }
              }),
            ],
          }),
        });

        saveBtn.addEventListener('click', () => void save());

        // --- preview toggle: split view <-> editor only ---------------------
        function setPreviewVisible(visible: boolean) {
          previewVisible = visible;
          main!.dataset.preview = visible ? 'on' : 'off';
          toggleBtn!.setAttribute('aria-pressed', String(visible));
          try {
            localStorage.setItem('editor:preview', visible ? 'on' : 'off');
          } catch {
            /* private mode / storage disabled — the toggle still works in-session */
          }
          if (visible) runPreview(); // catch up on edits made while hidden
        }
        toggleBtn.addEventListener('click', () => setPreviewVisible(!previewVisible));

        window.addEventListener('beforeunload', (e) => {
          if (isDirty()) e.preventDefault();
        });
      }
    </script>
  </body>
</html>
