---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { SOCIAL_LINKS } from '../lib/constants';
import fotoPerfil from '../assets/foto_perfil.jpeg';
import qrCover from '../assets/QR voting survey.png';
import pokeCover from '../assets/PokeAPI.webp';
import linkedinIcon from '../assets/linkedin.avif';
import githubIcon from '../assets/github.png';

const projects = [
  {
    name: 'QR Voting Survey',
    href: '/projects/qr-voting-survey/',
    cover: qrCover,
    description: 'Anonymous voting system with QR codes for live events',
    tech: ['Django', 'JWT', 'PostgreSQL', 'Docker']
  },
  {
    name: 'PokeAPI',
    href: '/projects/pokeapi/',
    cover: pokeCover,
    description: 'Interactive Pokédex with React frontend and FastAPI backend',
    tech: ['React', 'FastAPI', 'AWS', 'Docker']
  },
];
---

<Layout title="Jesús Caballero Rodríguez — Portfolio">
  <main>
    <section class="hero animate" style="animation-delay: 0.05s">
      <div class="hero-top">
        <div class="avatar">
          <Image src={fotoPerfil} alt="Retrato de Jesús Caballero Rodríguez" width={320} height={320} format="webp" />
        </div>
        <div class="hero-heading">
          <h1 class="gradient-text">Jesús Caballero Rodríguez</h1>
          <p class="tagline">Backend Engineer · Python · Data Engineering</p>
          <div class="social-links">
            <div class="social-link" data-url={SOCIAL_LINKS.linkedin} role="link" tabindex="0" aria-label="Abrir LinkedIn">
              <span class="social-icon-badge">
                <Image src={linkedinIcon} alt="" class="social-icon" />
              </span>
              <span class="social-link-label">LinkedIn</span>
              <button class="copy-btn" type="button" data-copy={SOCIAL_LINKS.linkedin} aria-label="Copiar enlace de LinkedIn" title="Copiar enlace">⧉</button>
            </div>
            <div class="social-link" data-url={SOCIAL_LINKS.github} role="link" tabindex="0" aria-label="Abrir GitHub">
              <span class="social-icon-badge">
                <Image src={githubIcon} alt="" class="social-icon" />
              </span>
              <span class="social-link-label">GitHub</span>
              <button class="copy-btn" type="button" data-copy={SOCIAL_LINKS.github} aria-label="Copiar enlace de GitHub" title="Copiar enlace">⧉</button>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-description">
        <p class="subtitle">
          Senior Backend Engineer with 7+ years of experience building scalable APIs, distributed
          systems, and data platforms with Python. I've worked on microservice architectures with
          Django and FastAPI across insurance, banking, and analytics, as well as event-driven
          systems with Kafka and Celery and cloud-native data solutions on AWS.
        </p>
        <p class="subtitle">
          I'm naturally curious and enjoy learning by building things. While backend engineering is
          my main focus, I regularly explore new technologies and ideas on my own — from React and
          modern web development to AI agents and developer tooling. I like understanding how
          things work, experimenting with them, and turning what I learn into real projects.
        </p>
        <p class="subtitle">
          Currently focused on backend, API, data engineering, and exploring how AI can change the
          way we build software.
        </p>
      </div>
    </section>
    <section class="projects-section animate" style="animation-delay: 0.35s">
      <div class="section-heading">
        <h2>Featured Projects</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="project-grid">
        {
          projects.map(({ name, href, cover, description, tech }) => (
            <a class="project-card" role="button" tabindex="0" href={href}>
              <Image src={cover} alt="" class="card-bg" loading="lazy" />
              <span class="card-overlay" aria-hidden="true"></span>
              <span class="card-arrow">→</span>
              <h3>{name}</h3>
              <p class="card-desc">{description}</p>
              <div class="card-tech">
                {tech.map(t => <span class="tech-tag">{t}</span>)}
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll('.project-card').forEach((card) => {
    const setTilt = (e) => {
      const r = card.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      card.style.transform = `perspective(800px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg) translateY(-3px)`;
    };
    const resetTilt = () => {
      card.style.transform = '';
    };
    card.addEventListener('pointermove', setTilt);
    card.addEventListener('pointerleave', resetTilt);
    card.addEventListener('blur', resetTilt);
  });

  const toast = document.createElement('div');
  toast.className = 'copy-toast';
  document.body.appendChild(toast);
  let toastTimer;

  const showToast = (msg) => {
    toast.textContent = msg;
    toast.classList.add('visible');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('visible'), 1800);
  };

  document.querySelectorAll('.social-link').forEach((pill) => {
    const openUrl = () => {
      const url = pill.dataset.url;
      if (url) window.open(url, '_blank', 'noopener');
    };
    pill.addEventListener('click', (e) => {
      if (e.target.closest('.copy-btn')) return;
      openUrl();
    });
    pill.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openUrl();
      }
    });
  });

  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const url = btn.dataset.copy;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 1800);
      showToast('Enlace copiado al portapapeles');
    });
  });
</script>

<style>
  .hero {
    margin-bottom: 2.5rem;
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .avatar {
    flex-shrink: 0;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(135deg, var(--accent), rgba(79, 140, 255, 0.2));
    box-shadow: 0 12px 40px rgba(79, 140, 255, 0.25);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
    display: block;
    border: 3px solid var(--bg);
  }

  .hero-heading h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.85rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.5rem 0.3rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    cursor: pointer;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease, background 0.25s ease;
  }

  .social-link:hover,
  .social-link:focus-visible {
    border-color: rgba(79, 140, 255, 0.55);
    background: linear-gradient(180deg, rgba(79, 140, 255, 0.1), rgba(79, 140, 255, 0.03));
    box-shadow: 0 8px 24px rgba(79, 140, 255, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  .social-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(79, 140, 255, 0.12);
    border: 1px solid rgba(79, 140, 255, 0.22);
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .social-link:hover .social-icon-badge {
    background: rgba(79, 140, 255, 0.2);
    border-color: rgba(79, 140, 255, 0.4);
  }

  .social-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }

  .social-link-label {
    color: var(--fg);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    user-select: none;
    transition: color 0.2s ease;
  }

  .social-link:hover .social-link-label,
  .social-link:focus-visible .social-link-label {
    color: var(--accent);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .copy-btn:hover {
    color: var(--accent);
    border-color: rgba(79, 140, 255, 0.6);
    background: rgba(79, 140, 255, 0.08);
    transform: scale(1.08);
  }

  .copy-btn.copied {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.6);
    background: rgba(74, 222, 128, 0.1);
  }

  .copy-toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    padding: 0.6rem 1.2rem;
    border-radius: 10px;
    background: #171b23;
    border: 1px solid rgba(74, 222, 128, 0.5);
    color: var(--fg);
    font-size: 0.875rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 100;
  }

  .copy-toast.visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .hero-description {
    margin-top: 1.5rem;
  }

  @media (max-width: 640px) {
    .hero-top {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
    }
    .avatar {
      width: 150px;
      height: 150px;
    }
    .hero-heading h1 {
      font-size: 2rem;
    }
    .social-links {
      justify-content: center;
    }
    .hero-description {
      text-align: center;
    }
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .section-heading h2 {
    font-size: 1.5rem;
    margin-bottom: 0;
    color: var(--fg);
    font-weight: 700;
    white-space: nowrap;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .project-card {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.5rem;
    background: linear-gradient(145deg, #171b23, #12151b);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.15s ease;
    will-change: transform;
    outline: none;
  }

  .card-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
    transition: opacity 0.3s ease, transform 0.4s ease;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 17, 21, 0.15), rgba(15, 17, 21, 0.88));
  }

  .card-arrow,
  .project-card h3 {
    position: relative;
    z-index: 2;
  }

  .project-card:hover .card-bg {
    opacity: 0.5;
    transform: scale(1.06);
  }

  .project-card:hover,
  .project-card:focus-visible {
    border-color: rgba(79, 140, 255, 0.6);
    box-shadow:
      0 10px 34px rgba(79, 140, 255, 0.16),
      inset 0 0 0 1px rgba(79, 140, 255, 0.12);
  }

  .project-card h3 {
    font-size: 1.1rem;
    margin-top: 0.5rem;
  }

  .card-desc {
    position: relative;
    z-index: 2;
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.4rem;
    line-height: 1.4;
  }

  .card-tech {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .tech-tag {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    background: rgba(255,255,255,0.03);
    transition: border-color 0.2s, color 0.2s;
  }

  .project-card:hover .tech-tag {
    border-color: rgba(79, 140, 255, 0.5);
    color: var(--accent);
  }

  .card-arrow {
    display: inline-block;
    color: var(--accent);
    font-size: 1.1rem;
    opacity: 0.4;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(4px);
  }
</style>