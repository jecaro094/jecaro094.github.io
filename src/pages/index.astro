---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import { SOCIAL_LINKS } from '../lib/constants';
import fotoPerfil from '../assets/foto_perfil.jpeg';
import linkedinIcon from '../assets/linkedin.avif';
import githubIcon from '../assets/github.png';
import cvIcon from '../assets/cv.png';

const home = await getEntry('site', 'home');
const { heading, tagline } = home.data;
const { Content: Bio } = await render(home);

const experiences = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order,
);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    name: p.data.cardName ?? p.data.title,
    href: `/projects/${p.id}/`,
    cover: p.data.cover,
    description: p.data.cardDescription ?? p.data.tagline,
    tech: p.data.cardTech ?? [],
    repoUrl: p.data.repoUrl,
  }));
---

<Layout title={home.data.title}>
  <main>
    <section class="hero animate" style="animation-delay: 0.05s">
      <div class="hero-top">
        <div class="avatar">
          <Image src={fotoPerfil} alt="Retrato de Jesús Caballero Rodríguez" width={320} height={320} format="webp" />
        </div>
        <div class="hero-heading">
          <h1 class="gradient-text">{heading}</h1>
          <p class="tagline">{tagline}</p>
          <div class="social-links">
            <div class="social-link" data-url={SOCIAL_LINKS.linkedin} role="link" tabindex="0" aria-label="Abrir LinkedIn">
              <span class="social-icon-badge">
                <Image src={linkedinIcon} alt="" class="social-icon" />
              </span>
              <span class="social-link-label">LinkedIn</span>
              <button class="copy-btn" type="button" data-copy={SOCIAL_LINKS.linkedin} aria-label="Copiar enlace de LinkedIn" title="Copiar enlace">
                <span class="copy-glyph" aria-hidden="true">⧉</span>
                <span class="copy-check" aria-hidden="true">✓</span>
              </button>
            </div>
            <div class="social-link" data-url={SOCIAL_LINKS.github} role="link" tabindex="0" aria-label="Abrir GitHub">
              <span class="social-icon-badge">
                <Image src={githubIcon} alt="" class="social-icon" />
              </span>
              <span class="social-link-label">GitHub</span>
              <button class="copy-btn" type="button" data-copy={SOCIAL_LINKS.github} aria-label="Copiar enlace de GitHub" title="Copiar enlace">
                <span class="copy-glyph" aria-hidden="true">⧉</span>
                <span class="copy-check" aria-hidden="true">✓</span>
              </button>
            </div>
            <a href="/cv" class="social-link" role="link" tabindex="0" aria-label="Abrir CV">
              <span class="social-icon-badge">
                <Image src={cvIcon} alt="" class="social-icon" />
              </span>
              <span class="social-link-label">CV →</span>
            </a>
          </div>
        </div>
      </div>
      <div class="hero-description">
        <Bio />
      </div>
    </section>

    <section class="timeline-section animate" style="animation-delay: 0.2s" aria-labelledby="experience-heading" id="experience">
      <div class="section-heading">
        <h2 id="experience-heading">Experience</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">{experiences.length} roles</span>
      </div>
      <ol class="timeline">
        {
          experiences.map(({ data: e }) => (
            <li class="timeline-item" style={`--mark:${e.brandColor}`}>
              <span class="timeline-marker" aria-hidden="true"></span>
              <div class="timeline-period">
                <span class="timeline-year">{e.period}</span>
              </div>
              <div class="timeline-body">
                <article class="timeline-card">
                  <header class="timeline-head">
                    <Image src={e.logo} alt="" class="timeline-logo" width={40} height={40} />
                    <div class="timeline-titles">
                      <h3 class="timeline-role">{e.role}</h3>
                      <p class="timeline-company">
                        {e.company}{e.via && <span class="timeline-via"> · {e.via}</span>}
                      </p>
                    </div>
                  </header>
                  <p class="timeline-summary">{e.summary}</p>
                  <ul class="timeline-tech" aria-label="Technologies">
                    {e.tech.map((t) => <li class="tech-tag">{t}</li>)}
                  </ul>
                </article>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="projects-section animate" style="animation-delay: 0.35s" id="projects">
      <div class="section-heading">
        <h2>Featured Projects</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="project-grid">
        {
          projects.map(({ name, href, cover, description, tech, repoUrl }) => (
            <div class="project-card" role="link" tabindex="0" data-href={href}>
              <Image src={cover} alt="" class="card-bg" loading="lazy" />
              <span class="card-overlay" aria-hidden="true"></span>
              <span class="card-arrow">→</span>
              <h3>{name}</h3>
              <p class="card-desc">{description}</p>
              <div class="card-tech">
                {tech.map(t => <span class="tech-tag">{t}</span>)}
              </div>
              {repoUrl && (
                <div class="card-repo" data-urls={Array.isArray(repoUrl) ? repoUrl.join(',') : repoUrl}>
                  <Image src={githubIcon} alt="" class="card-repo-icon" />
                  {Array.isArray(repoUrl) && repoUrl.length > 1 && (
                    <div class="card-repo-dropdown">
                      {repoUrl.map((url) => (
                        <a href={url} target="_blank" rel="noopener noreferrer" class="card-repo-item" onclick="event.stopPropagation()">
                          {url.split('/').slice(-2).join('/')}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll('.project-card').forEach((card) => {
    const setTilt = (e) => {
      const r = card.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      card.style.transform = `perspective(800px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg) translateY(-3px)`;
    };
    const resetTilt = () => {
      card.style.transform = '';
    };
    card.addEventListener('pointermove', setTilt);
    card.addEventListener('pointerleave', resetTilt);
    card.addEventListener('blur', resetTilt);

    card.addEventListener('click', (e) => {
      if (e.target.closest('.card-repo')) return;
      window.location.href = card.dataset.href;
    });
    card.addEventListener('keydown', (e) => {
      if ((e.key === 'Enter' || e.key === ' ') && !e.target.closest('.card-repo')) {
        e.preventDefault();
        window.location.href = card.dataset.href;
      }
    });
  });

  document.querySelectorAll('.card-repo[data-urls]').forEach((repo) => {
    repo.addEventListener('click', (e) => {
      e.stopPropagation();
      const urls = repo.dataset.urls;
      if (urls && !urls.includes(',')) {
        window.open(urls, '_blank', 'noopener');
      }
    });
  });

  document.querySelectorAll('.social-link').forEach((pill) => {
    const openUrl = () => {
      const url = pill.dataset.url;
      if (url) window.open(url, '_blank', 'noopener');
    };
    pill.addEventListener('click', (e) => {
      if (e.target.closest('.copy-btn')) return;
      openUrl();
    });
    pill.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openUrl();
      }
    });
  });

  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const url = btn.dataset.copy;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      btn.classList.add('copied');
      clearTimeout(btn._copyTimer);
      btn._copyTimer = setTimeout(() => btn.classList.remove('copied'), 1600);
    });
  });

  const sections = document.querySelectorAll('[id="experience"], [id="projects"]');
  const tabs = document.querySelectorAll('.nav-tab[data-section]');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        tabs.forEach(t => t.classList.remove('active'));
        const active = document.querySelector(`.nav-tab[data-section="${entry.target.id}"]`);
        if (active) active.classList.add('active');
      }
    });
  }, { rootMargin: '-20% 0px -60% 0px' });

  sections.forEach(s => observer.observe(s));
</script>

<style>
  .hero {
    margin-bottom: 2.5rem;
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .avatar {
    flex-shrink: 0;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(135deg, var(--accent), rgba(79, 140, 255, 0.2));
    box-shadow: 0 12px 40px rgba(79, 140, 255, 0.25);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
    display: block;
    border: 3px solid var(--bg);
  }

  .hero-heading h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.85rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.5rem 0.3rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    cursor: pointer;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease, background 0.25s ease;
  }

  .social-link:hover,
  .social-link:focus-visible {
    border-color: rgba(79, 140, 255, 0.55);
    background: linear-gradient(180deg, rgba(79, 140, 255, 0.1), rgba(79, 140, 255, 0.03));
    box-shadow: 0 8px 24px rgba(79, 140, 255, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .social-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(79, 140, 255, 0.12);
    border: 1px solid rgba(79, 140, 255, 0.22);
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .social-link:hover .social-icon-badge {
    background: rgba(79, 140, 255, 0.2);
    border-color: rgba(79, 140, 255, 0.4);
  }

  .social-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }

  .social-link-label {
    color: var(--fg);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    user-select: none;
    transition: color 0.2s ease;
  }

  .social-link:hover .social-link-label,
  .social-link:focus-visible .social-link-label {
    color: var(--accent);
  }

  .copy-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .copy-glyph,
  .copy-check {
    display: block;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  /* Green check sits stacked on top of the copy glyph, hidden until copied */
  .copy-check {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 700;
    color: #4ade80;
    opacity: 0;
    transform: scale(0.5);
  }

  .copy-btn:hover {
    color: var(--accent);
    border-color: rgba(79, 140, 255, 0.6);
    background: rgba(79, 140, 255, 0.08);
    transform: scale(1.08);
  }

  .copy-btn.copied {
    border-color: rgba(74, 222, 128, 0.6);
    background: rgba(74, 222, 128, 0.12);
  }

  .copy-btn.copied .copy-glyph {
    opacity: 0;
    transform: scale(0.5);
  }

  .copy-btn.copied .copy-check {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-glyph,
    .copy-check {
      transition: opacity 0.18s ease;
      transform: none;
    }
    .copy-btn.copied .copy-check {
      transform: none;
    }
  }

  .hero-description {
    margin-top: 1.5rem;
  }

  .hero-description :global(p) {
    color: var(--muted);
    margin-bottom: 2rem;
  }

  @media (max-width: 640px) {
    .hero-top {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
    }
    .avatar {
      width: 150px;
      height: 150px;
    }
    .hero-heading h1 {
      font-size: 2rem;
    }
    .social-links {
      justify-content: center;
    }
    .hero-description {
      text-align: center;
    }
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .section-heading h2 {
    font-size: 1.5rem;
    margin-bottom: 0;
    color: var(--fg);
    font-weight: 700;
    white-space: nowrap;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .project-card {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.5rem;
    background: linear-gradient(145deg, #171b23, #12151b);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.15s ease;
    will-change: transform;
    outline: none;
  }

  .card-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
    transition: opacity 0.3s ease, transform 0.4s ease;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 17, 21, 0.15), rgba(15, 17, 21, 0.88));
  }

  .card-arrow,
  .project-card h3 {
    position: relative;
    z-index: 2;
  }

  .project-card:hover .card-bg {
    opacity: 0.5;
    transform: scale(1.06);
  }

  .project-card:hover,
  .project-card:focus-visible {
    border-color: rgba(79, 140, 255, 0.6);
    box-shadow:
      0 10px 34px rgba(79, 140, 255, 0.16),
      inset 0 0 0 1px rgba(79, 140, 255, 0.12);
  }

  .project-card h3 {
    font-size: 1.1rem;
    margin-top: 0.5rem;
  }

  .card-desc {
    position: relative;
    z-index: 2;
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.4rem;
    line-height: 1.4;
  }

  .card-tech {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .tech-tag {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    background: rgba(255,255,255,0.03);
    transition: border-color 0.2s, color 0.2s;
  }

  .project-card:hover .tech-tag {
    border-color: rgba(79, 140, 255, 0.5);
    color: var(--accent);
  }

  .card-arrow {
    display: inline-block;
    color: var(--accent);
    font-size: 1.1rem;
    opacity: 0.4;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  /* ── Card repo icon ──────────────────────────────────── */

  .card-repo {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .card-repo:hover {
    background: rgba(79, 140, 255, 0.2);
    border-color: rgba(79, 140, 255, 0.6);
    transform: scale(1.1);
  }

  .card-repo-icon {
    width: 18px;
    height: 18px;
    filter: invert(1) brightness(1.2);
    transition: filter 0.2s ease;
  }

  .card-repo:hover .card-repo-icon {
    filter: invert(1) brightness(1.5);
  }

  .card-repo-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 200px;
    background: #1a1f28;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.35rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .card-repo-dropdown::before {
    content: "";
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 10px;
  }

  .card-repo:hover .card-repo-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .card-repo-item {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-repo-item:hover {
    background: rgba(79, 140, 255, 0.12);
    color: var(--accent);
  }

  /* ── Timeline / Experience ─────────────────────────────── */

  .timeline-section {
    margin: 0 0 3rem;
  }

  .section-count {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    white-space: nowrap;
  }

  .timeline {
    position: relative;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* vertical line */
  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 89px;
    width: 1px;
    background: var(--border);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1.5rem;
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-period {
    text-align: center;
    padding-top: 0.15rem;
    position: relative;
  }

  .timeline-year {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .timeline-body {
    position: relative;
  }

  .timeline-marker {
    position: absolute;
    left: 85px;
    top: 0.15rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--mark, var(--accent));
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px color-mix(in srgb, var(--mark, var(--accent)) 45%, transparent);
    z-index: 1;
  }

  .timeline-card {
    border: 1px solid var(--border);
    border-left: 3px solid var(--mark, var(--accent));
    border-radius: 12px;
    padding: 1.15rem 1.25rem;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012));
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  .timeline-card:hover {
    border-color: color-mix(in srgb, var(--mark, var(--accent)) 50%, transparent);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.25),
                0 0 0 1px color-mix(in srgb, var(--mark, var(--accent)) 12%, transparent);
    transform: translateY(-2px);
  }

  .timeline-card-featured {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .timeline-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .timeline-logo {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid var(--border);
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.04);
  }

  .timeline-titles {
    min-width: 0;
  }

  .timeline-role {
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--fg);
    line-height: 1.3;
  }

  .timeline-company {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.3;
    margin-top: 0.1rem;
  }

  .timeline-via {
    color: color-mix(in srgb, var(--muted) 65%, transparent);
  }

  .timeline-summary {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 0.65rem;
